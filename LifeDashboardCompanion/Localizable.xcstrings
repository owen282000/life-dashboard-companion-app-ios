    "This file has no custom headers. The ones on this iPhone are kept, for the addresses they were already sent to." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا الملف على ترويسات مخصصة. يتم الاحتفاظ بالترويسات الموجودة على هذا الـ iPhone، للعناوين التي كانت تُرسل إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei hat keine eigenen Header. Die auf diesem iPhone bleiben erhalten, für die Adressen, an die sie schon gesendet wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo no tiene encabezados personalizados. Se mantienen los de este iPhone, para las direcciones a las que ya se enviaban."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier ne contient aucun en-tête personnalisé. Ceux de cet iPhone sont conservés, pour les adresses auxquelles ils étaient déjà envoyés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ाइल में कोई कस्टम हेडर नहीं है। इस iPhone पर मौजूद हेडर उन पतों के लिए बने रहते हैं जिन पर वे पहले से भेजे जाते थे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file non contiene header personalizzati. Restano quelli su questo iPhone, per gli indirizzi a cui venivano già inviati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルにはカスタムヘッダーがありません。このiPhoneのカスタムヘッダーは、これまでの送信先アドレスでそのまま使われます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bestand heeft geen eigen headers. Die op deze iPhone blijven behouden, voor de adressen waar ze al heen gingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
