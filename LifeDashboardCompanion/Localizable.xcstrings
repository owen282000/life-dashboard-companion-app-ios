    "Per-day totals (steps, distance, calories) as the Health app counts them, with overlapping iPhone and Watch data counted once" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجاميع يومية (الخطوات والمسافة والسعرات الحرارية) كما يحسبها تطبيق صحتي، مع احتساب بيانات iPhone وApple Watch المتداخلة مرة واحدة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagessummen (Schritte, Distanz, Kalorien) so, wie die Health-App sie zählt, überlappende iPhone- und Watch-Daten nur einmal gezählt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totales por día (pasos, distancia, calorías) como los cuenta la app Salud, con los datos superpuestos del iPhone y el Watch contados una sola vez"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totaux par jour (pas, distance, calories) tels que les compte l’app Santé, les données de l’iPhone et de la Watch qui se chevauchent n’étant comptées qu’une fois"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दिन का योग (क़दम, दूरी, कैलोरी) उसी तरह जैसे स्वास्थ्य ऐप गिनता है, iPhone और Watch का ओवरलैप होने वाला डेटा एक ही बार गिना जाता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totali giornalieri (passi, distanza, calorie) come li calcola l'app Salute, con i dati sovrapposti di iPhone e Watch contati una volta sola"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアAppと同じ方法で集計した1日ごとの合計（歩数、距離、カロリー）。iPhoneとApple Watchで重複したデータは1回だけ数えます"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalen per dag (stappen, afstand, calorieën) zoals de Gezondheid-app ze telt, met overlappende iPhone- en Watch-data één keer geteld"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totais por dia (passos, distância, calorias) como o app Saúde os conta, com os dados sobrepostos do iPhone e do Watch contados uma vez"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按“健康”App 的统计方式计算的每日总计（步数、距离、能量），iPhone 和 Apple Watch 的重叠数据只计算一次"
          }
        }
      }
    },
