    "MQTT publishing stops, and the broker's address and login are deleted from this iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف النشر عبر MQTT، ويُحذف عنوان الوسيط وبيانات تسجيل الدخول من هذا الـ iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die MQTT-Veröffentlichung stoppt, und Adresse und Anmeldedaten des Brokers werden von diesem iPhone gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publicación MQTT se detiene, y la dirección y las credenciales del broker se eliminan de este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publication MQTT s’arrête, et l’adresse et les identifiants du broker sont supprimés de cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MQTT पब्लिशिंग रुक जाती है, और ब्रोकर का पता और लॉगिन इस iPhone से मिटा दिए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pubblicazione MQTT si interrompe e l'indirizzo e le credenziali del broker vengono eliminati da questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MQTTでの公開を停止し、ブローカーのアドレスとログイン情報をこのiPhoneから削除します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MQTT-publicatie stopt, en het adres en de inloggegevens van de broker worden van deze iPhone verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A publicação MQTT para, e o endereço e o login do broker são apagados deste iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MQTT 发布将停止，代理服务器的地址和登录信息将从这部 iPhone 上删除。"
          }
        }
      }
    },
    "MQTT topic becomes %@, so this iPhone and the other phone do not share sensors." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح موضوع MQTT %@، كي لا يتشارك هذا الـ iPhone والهاتف الآخر المستشعرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das MQTT-Topic wird zu %@, damit dieses iPhone und das andere Telefon keine Sensoren teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema MQTT pasa a ser %@, para que este iPhone y el otro teléfono no compartan sensores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le topic MQTT devient %@, pour que cet iPhone et l’autre téléphone ne partagent pas de capteurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MQTT टॉपिक %@ हो जाता है, ताकि यह iPhone और दूसरा फ़ोन सेंसर शेयर न करें।"
          }
