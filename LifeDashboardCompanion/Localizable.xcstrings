    "Pick them in What to send, then tap Sync now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخترها في «ما يتم إرساله»، ثم اضغط على «المزامنة الآن»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle sie unter Was senden und tippe dann auf Jetzt synchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elígelos en Qué enviar y luego toca Sincronizar ahora."
