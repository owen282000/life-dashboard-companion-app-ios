    },
    "These settings never sync. Add a time, a day, or shorten the quiet hours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتم المزامنة أبدًا بهذه الإعدادات. أضف وقتًا أو يومًا، أو قصّر ساعات الهدوء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesen Einstellungen wird nie synchronisiert. Füge eine Zeit oder einen Tag hinzu oder verkürze die Ruhezeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con esta configuración nunca se sincroniza. Agrega una hora o un día, o acorta las horas de silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec ces réglages, aucune synchronisation n’a lieu. Ajoutez une heure, un jour, ou raccourcissez les heures de silence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन सेटिंग्ज़ से कभी सिंक नहीं होगा। कोई समय या दिन जोड़ें, या शांत समय छोटा करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con queste impostazioni non si sincronizza mai. Aggiungi un orario o un giorno, oppure accorcia le ore di silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定では同期が一度も行われません。時刻か曜日を追加するか、休止時間帯を短くしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze instellingen wordt er nooit gesynchroniseerd. Voeg een tijd of dag toe, of verkort de stille uren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com estas configurações nunca há sincronização. Adicione um horário, um dia, ou encurte o horário de silêncio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按这些设置永远不会同步。请添加时间或日期，或缩短免打扰时段。"
          }
        }
      }
    },
    "This address is on the internet without encryption. Anyone along the way can read your health data. Use an https address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العنوان على الإنترنت بدون تشفير. يمكن لأي طرف على الطريق قراءة بياناتك الصحية. استخدم عنوان https."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse liegt unverschlüsselt im Internet. Jeder auf dem Weg kann deine Gesundheitsdaten lesen. Nutze eine https-Adresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dirección está en internet sin cifrar. Cualquiera en el camino puede leer tus datos de salud. Usa una dirección https."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette adresse est sur Internet sans chiffrement. N’importe qui sur le trajet peut lire vos données de santé. Utilisez une adresse https."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पता बिना एन्क्रिप्शन के इंटरनेट पर है। रास्ते में कोई भी आपका स्वास्थ्य डेटा पढ़ सकता है। https पता इस्तेमाल करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo indirizzo è su internet senza crittografia. Chiunque lungo il percorso può leggere i tuoi dati sulla salute. Usa un indirizzo https."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスは暗号化なしでインターネットを通ります。途中で誰でも健康データを読み取れてしまいます。httpsのアドレスを使ってください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit adres staat onversleuteld op het internet. Iedereen onderweg kan je gezondheidsdata lezen. Gebruik een https-adres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este endereço está na internet sem criptografia. Qualquer um no caminho pode ler seus dados de saúde. Use um endereço https."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地址位于互联网上且未加密。传输途中的任何人都能读取你的健康数据。请使用 https 地址。"
          }
        }
      }
    },
