          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se guardaron los primeros %@ caracteres de este payload."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les %@ premiers caractères de ce payload ont été conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
