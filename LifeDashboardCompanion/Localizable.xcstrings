    "Health data can't be read while your iPhone is locked." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن قراءة البيانات الصحية أثناء قفل iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsdaten können nicht gelesen werden, solange dein iPhone gesperrt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de salud no se pueden leer mientras el iPhone está bloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
