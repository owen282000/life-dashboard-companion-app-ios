    "Home Assistant takes in about the last year for now. A webhook or the Life Dashboard stack gets everything." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستقبل Home Assistant حاليًا بيانات السنة الأخيرة تقريبًا. أما webhook أو Life Dashboard Stack فيحصل على كل شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant übernimmt vorerst etwa das letzte Jahr. Ein Webhook oder der Life Dashboard Stack bekommt alles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora, Home Assistant recibe aproximadamente el último año. Un webhook o el Life Dashboard Stack lo reciben todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’instant, Home Assistant reprend environ la dernière année. Un webhook ou le Life Dashboard Stack reçoit tout."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant अभी लगभग पिछले एक साल का डेटा लेता है। वेबहुक या Life Dashboard stack को सब कुछ मिलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ora Home Assistant accetta circa l'ultimo anno. Un webhook o lo stack Life Dashboard riceve tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistantが現在取り込めるのは直近の約1年分です。WebhookやLife Dashboard Stackにはすべて送信されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant neemt voorlopig ongeveer het laatste jaar over. Een webhook of de Life Dashboard-stack krijgt alles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por enquanto, o Home Assistant recebe mais ou menos o último ano. Um webhook ou o Life Dashboard Stack recebe tudo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant 目前大约接收最近一年的数据。Webhook 或 Life Dashboard Stack 会接收全部数据。"
          }
        }
      }
    },
