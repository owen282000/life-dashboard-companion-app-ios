    "Stopped after %lld of %lld windows: HealthKit did not return %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف بعد %1$lld من أصل %2$lld من الدفعات: لم يُرجع HealthKit %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach %1$lld von %2$lld Blöcken angehalten: HealthKit hat keine Daten für %3$@ geliefert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stopped after %1$lld of %2$lld windows: HealthKit did not return %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo después de %1$lld de %2$lld bloques: HealthKit no devolvió %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté après %1$lld blocs sur %2$lld : HealthKit n’a pas renvoyé %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld में से %1$lld हिस्सों के बाद रुक गया: HealthKit ने %3$@ नहीं लौटाया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermo dopo %1$lld blocchi su %2$lld: HealthKit non ha restituito %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lldブロック中%1$lldブロックで停止しました：HealthKitが%3$@を返しませんでした。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestopt na %1$lld van %2$lld blokken: HealthKit gaf geen %3$@ terug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parou depois de %1$lld de %2$lld blocos: o HealthKit não retornou %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在第 %1$lld 批（共 %2$lld 批）后停止：HealthKit 未返回%3$@。"
          }
        }
      }
    },
    "Stops after the current chunk. You can resume later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف بعد الدفعة الحالية. يمكنك الاستئناف لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält nach dem aktuellen Block an. Du kannst später fortsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene después del bloque actual. Puedes reanudarla más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’arrête après le bloc en cours. Vous pourrez reprendre plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा हिस्से के बाद रुक जाता है। आप बाद में फिर से शुरू कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ferma dopo il blocco in corso. Puoi riprendere più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のブロックが終わったら停止します。あとで再開できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopt na het huidige blok. Je kunt later hervatten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para depois do bloco atual. Você pode retomar mais tarde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前这一批完成后停止。你可以稍后继续。"
          }
        }
      }
    },
