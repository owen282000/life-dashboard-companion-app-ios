    "Your iPhone is locked, so Health data can't be read. The next sync catches up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone مقفل، لذا لا يمكن قراءة البيانات الصحية. ستعوّض المزامنة التالية ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone ist gesperrt, daher können keine Gesundheitsdaten gelesen werden. Die nächste Synchronisierung holt das nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone está bloqueado, así que no se pueden leer los datos de salud. La próxima sincronización se pone al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone est verrouillé : les données de santé ne peuvent pas être lues. La prochaine synchronisation rattrapera le retard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका iPhone लॉक है, इसलिए स्वास्थ्य डेटा पढ़ा नहीं जा सकता। अगला सिंक बाकी डेटा भेज देगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'iPhone è bloccato, quindi i dati di Salute non si possono leggere. La prossima sincronizzazione recupera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneがロックされているため、ヘルスケアデータを読み取れません。次回の同期でまとめて送信されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je iPhone is vergrendeld, dus gezondheidsdata kan niet worden gelezen. De volgende synchronisatie haalt het in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu iPhone está bloqueado, então os dados do Saúde não podem ser lidos. A próxima sincronização recupera o atraso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iPhone 已锁定，因此无法读取健康数据。下次同步会补上。"
          }
        }
      }
    },
    "Your other addresses keep their own signing secret and headers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ عناوينك الأخرى بسر التوقيع والترويسات الخاصة بها."
          }
        },
        "de" : {
