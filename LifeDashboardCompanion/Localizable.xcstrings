    "Webhooks that require it refuse every sync until you import it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عناوين webhook التي تتطلبها ترفض كل مزامنة إلى أن تستوردها مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webhooks, die es verlangen, lehnen jede Synchronisierung ab, bis du es erneut importierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los webhooks que lo exigen rechazan todas las sincronizaciones hasta que lo vuelvas a importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les webhooks qui l’exigent refusent chaque synchronisation tant que vous ne l’avez pas importé à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन वेबहुक को इसकी ज़रूरत है, वे इसे फिर से इंपोर्ट करने तक हर सिंक मना कर देंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I webhook che lo richiedono rifiutano ogni sincronizzazione finché non lo importi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証明書が必要なWebhookは、もう一度読み込むまですべての同期を拒否します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webhooks die het vereisen, weigeren elke synchronisatie tot je het opnieuw importeert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os webhooks que exigem o certificado recusam todas as sincronizações até você importá-lo de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求客户端证书的 Webhook 会拒绝每次同步，直到你重新导入证书。"
          }
        }
