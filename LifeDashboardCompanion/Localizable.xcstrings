        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 锁定时无法读取健康数据。"
          }
        }
      }
    },
    "Health data can't be read while your iPhone is locked. If it is locked at that time, that sync sends nothing and the next one catches up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن قراءة البيانات الصحية أثناء قفل iPhone. إذا كان مقفلًا في ذلك الوقت، فلن ترسل تلك المزامنة شيئًا وستعوّضها المزامنة التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsdaten können nicht gelesen werden, solange dein iPhone gesperrt ist. Ist es zu diesem Zeitpunkt gesperrt, sendet diese Synchronisierung nichts und die nächste holt es nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de salud no se pueden leer mientras el iPhone está bloqueado. Si está bloqueado a esa hora, esa sincronización no envía nada y la siguiente se pone al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de santé ne peuvent pas être lues tant que votre iPhone est verrouillé. S’il est verrouillé à ce moment-là, cette synchronisation n’envoie rien et la suivante rattrape le retard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone लॉक होने पर स्वास्थ्य डेटा पढ़ा नहीं जा सकता। अगर उस समय वह लॉक है, तो वह सिंक कुछ नहीं भेजता और अगला सिंक बाकी डेटा भेज देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati di Salute non si possono leggere mentre l'iPhone è bloccato. Se a quell'ora è bloccato, quella sincronizzazione non invia nulla e la successiva recupera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneがロックされている間は、ヘルスケアデータを読み取れません。その時刻にロックされていた場合、その回の同期では何も送信されず、次回の同期でまとめて送信されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezondheidsdata kan niet worden gelezen zolang je iPhone vergrendeld is. Is hij op dat moment vergrendeld, dan verstuurt die synchronisatie niets en haalt de volgende het in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do Saúde não podem ser lidos com o iPhone bloqueado. Se ele estiver bloqueado nesse horário, essa sincronização não envia nada e a próxima recupera o atraso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 锁定时无法读取健康数据。如果到时 iPhone 处于锁定状态，这次同步不会发送任何内容，下次同步会补上。"
          }
        }
      }
    },
