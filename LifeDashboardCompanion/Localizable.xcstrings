    "When set, every request includes X-Signature: sha256=HMAC-SHA256(secret, body) so your server can verify the sender." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تعيينه، يتضمن كل طلب X-Signature: sha256=HMAC-SHA256(secret, body) ليتمكن خادمك من التحقق من المرسِل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn gesetzt, enthält jede Anfrage X-Signature: sha256=HMAC-SHA256(secret, body), damit dein Server den Absender prüfen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo configuras, cada solicitud incluye X-Signature: sha256=HMAC-SHA256(secret, body) para que tu servidor pueda verificar el remitente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si défini, chaque requête contient X-Signature: sha256=HMAC-SHA256(secret, body) pour que votre serveur puisse vérifier l’expéditeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेट होने पर हर रिक्वेस्ट में X-Signature: sha256=HMAC-SHA256(secret, body) होता है, ताकि आपका सर्वर भेजने वाले की पुष्टि कर सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se impostato, ogni richiesta include X-Signature: sha256=HMAC-SHA256(secret, body), così il tuo server può verificare il mittente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定すると、すべてのリクエストにX-Signature: sha256=HMAC-SHA256(secret, body)が付き、サーバーで送信元を確認できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingesteld, bevat elk verzoek X-Signature: sha256=HMAC-SHA256(secret, body), zodat je server de afzender kan verifiëren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando definido, cada solicitação inclui X-Signature: sha256=HMAC-SHA256(secret, body), para que seu servidor possa verificar o remetente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置后，每个请求都会包含 X-Signature: sha256=HMAC-SHA256(secret, body)，以便你的服务器验证发送方。"
          }
        }
      }
    },
