    "Fill the frame with the pairing code your receiver shows, such as Home Assistant or the Life Dashboard Stack. Closer is better." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "املأ الإطار برمز الإقران الذي تعرضه جهة الاستقبال، مثل Home Assistant أو Life Dashboard Stack. كلما اقتربت كان أفضل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fülle den Rahmen mit dem Kopplungscode, den dein Empfänger zeigt, etwa Home Assistant oder der Life Dashboard Stack. Näher ist besser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuadra el código de vinculación que muestra tu receptor, como Home Assistant o el Life Dashboard Stack. Cuanto más cerca, mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadrez le code d’association affiché par votre récepteur, par exemple Home Assistant ou le Life Dashboard Stack. Plus vous êtes près, mieux c’est."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका रिसीवर, जैसे Home Assistant या Life Dashboard Stack, जो पेयरिंग कोड दिखाता है उसे फ़्रेम में पूरा भरें। जितना पास, उतना बेहतर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice di associazione mostrato dal tuo destinatario, per esempio Home Assistant o lo stack Life Dashboard. Più vicino è meglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受信側（Home AssistantやLife Dashboard Stackなど）に表示されたペアリングコードを枠いっぱいに映してください。近づけるほど読み取りやすくなります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul het kader met de koppelcode die je ontvanger toont, zoals Home Assistant of de Life Dashboard Stack. Dichterbij werkt beter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquadre o código de pareamento que o seu receptor mostra, como o do Home Assistant ou do Life Dashboard Stack. Quanto mais perto, melhor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让接收端显示的配对码（例如 Home Assistant 或 Life Dashboard Stack）填满取景框。距离越近越好。"
          }
        }
      }
    },
