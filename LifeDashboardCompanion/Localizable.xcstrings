        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन सेटिंग्ज़ से कभी सिंक नहीं होगा। कोई समय या दिन जोड़ें, या शांत समय छोटा करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con queste impostazioni non si sincronizza mai. Aggiungi un orario o un giorno, oppure accorcia le ore di silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定では同期が一度も行われません。時刻か曜日を追加するか、休止時間帯を短くしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
