    "Any receiver can show a pairing code, such as Home Assistant, the Life Dashboard Stack or your own server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي جهة استقبال عرض رمز إقران، مثل Home Assistant أو Life Dashboard Stack أو خادمك الخاص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Empfänger kann einen Kopplungscode zeigen, etwa Home Assistant, der Life Dashboard Stack oder dein eigener Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier receptor puede mostrar un código de vinculación, como Home Assistant, Life Dashboard Stack o tu propio servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout récepteur peut afficher un code d’association, comme Home Assistant, le Life Dashboard Stack ou votre propre serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी रिसीवर पेयरिंग कोड दिखा सकता है, जैसे Home Assistant, Life Dashboard Stack या आपका अपना सर्वर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
