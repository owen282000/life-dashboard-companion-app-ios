    "Delivery failed after %lld of %lld windows. Resume continues from there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل التسليم بعد %1$lld من أصل %2$lld من الدفعات. «استئناف» يتابع من هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zustellung fehlgeschlagen nach %1$lld von %2$lld Blöcken. Fortsetzen macht dort weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delivery failed after %1$lld of %2$lld windows. Resume continues from there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrega falló después de %1$lld de %2$lld bloques. Reanudar continúa desde ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la livraison après %1$lld blocs sur %2$lld. Reprendre poursuit à partir de là."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld में से %1$lld हिस्सों के बाद डिलीवरी विफल रही। फिर से शुरू करें दबाने पर वहीं से जारी रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consegna non riuscita dopo %1$lld blocchi su %2$lld. Riprendi continua da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lldブロック中%1$lldブロックで配信に失敗しました。「再開」で続きから送信します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aflevering mislukt na %1$lld van %2$lld blokken. Hervatten gaat vanaf daar verder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrega falhou depois de %1$lld de %2$lld blocos. Retomar continua dali."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在第 %1$lld 批（共 %2$lld 批）后传送失败。继续时将从该处接着发送。"
          }
        }
      }
    },
    "Dense series like heart rate can be sent as averages per time window instead of every single record. Smaller payloads, less detail." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن إرسال السلاسل الكثيفة مثل نبض القلب كمتوسطات لكل فترة زمنية بدلًا من كل إدخال على حدة. حمولات أصغر وتفاصيل أقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dichte Reihen wie die Herzfrequenz lassen sich als Mittelwerte pro Zeitfenster senden statt als einzelne Datensätze. Kleinere Payloads, weniger Details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las series densas, como la frecuencia cardiaca, se pueden enviar como promedios por intervalo de tiempo en lugar de cada registro por separado. Payloads más pequeños, menos detalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séries denses comme la fréquence cardiaque peuvent être envoyées sous forme de moyennes par plage de temps plutôt qu’enregistrement par enregistrement. Des payloads plus petits, moins de détails."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हृदय गति जैसी घनी सीरीज़ को हर एक रिकॉर्ड के बजाय हर समय-विंडो के औसत के रूप में भेजा जा सकता है। पेलोड छोटे, जानकारी कम।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serie fitte come la frequenza cardiaca possono essere inviate come medie per intervallo di tempo invece di ogni singolo record. Payload più piccoli, meno dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数のように密度の高いデータは、レコードを1件ずつ送る代わりに、時間枠ごとの平均として送れます。ペイロードは小さくなりますが、詳細は減ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dichte reeksen zoals hartslag kun je versturen als gemiddelden per tijdvenster in plaats van elke losse meting. Kleinere payloads, minder detail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séries densas como a frequência cardíaca podem ser enviadas como médias por janela de tempo, em vez de cada registro. Payloads menores, menos detalhe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率等密集数据序列可以按时间窗口发送平均值，而不是发送每一条记录。数据包更小，细节更少。"
          }
        }
      }
    },
