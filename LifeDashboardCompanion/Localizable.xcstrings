    "Nothing to send yet, or iOS gives no access. Settings > Health > Data Access & Devices > Life Dashboard shows what it may read." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شيء لإرساله بعد، أو أن iOS لا يمنح الوصول. تعرض الإعدادات > صحتي > الوصول إلى البيانات والأجهزة > Life Dashboard ما يمكنه قراءته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts zu senden, oder iOS gibt keinen Zugriff. Einstellungen > Health > Datenzugriff & Geräte > Life Dashboard zeigt, was die App lesen darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay nada que enviar, o iOS no da acceso. En Configuración > Salud > Acceso a datos y dispositivos > Life Dashboard ves lo que puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à envoyer pour l’instant, ou iOS ne donne pas l’accès. Réglages > Santé > Accès aux données et appareils > Life Dashboard indique ce que l’app peut lire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी भेजने के लिए कुछ नहीं है, या iOS ऐक्सेस नहीं देता। सेटिंग्ज़ > स्वास्थ्य > डेटा ऐक्सेस और डिवाइस > Life Dashboard में दिखता है कि यह क्या पढ़ सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente da inviare, oppure iOS non concede l'accesso. In Impostazioni > Salute > Accesso ai dati e dispositivi > Life Dashboard vedi cosa può leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信するものがまだないか、iOSがアクセスを許可していません。「設定」>「ヘルスケア」>「データアクセスとデバイス」>「Life Dashboard」で、読み取りが許可されている項目を確認できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets te versturen, of iOS geeft geen toegang. Instellingen > Gezondheid > Datatoegang en apparaten > Life Dashboard laat zien wat de app mag lezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada para enviar ainda, ou o iOS não dá acesso. Ajustes > Saúde > Acesso a Dados e Dispositivos > Life Dashboard mostra o que o app pode ler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无可发送的内容，或者 iOS 未授予访问权限。在“设置”>“健康”>“数据访问与设备”>“Life Dashboard”中可以查看它可读取哪些数据。"
          }
        }
      }
    },
    "Nothing was delivered since %@. iOS may be holding the app back: open it to sync, and check Background App Refresh and Low Power Mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُسلَّم شيء منذ %@. قد يكون iOS يعطّل التطبيق: افتحه للمزامنة، وتحقق من «تحديث التطبيقات في الخلفية» و«وضع الطاقة المنخفضة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit %@ wurde nichts zugestellt. Vielleicht hält iOS die App zurück: Öffne sie zum Synchronisieren und prüfe die Hintergrundaktualisierung und den Stromsparmodus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se entregó nada desde %@. Puede que iOS esté reteniendo la app: ábrela para sincronizar y revisa la actualización en segundo plano y el modo de bajo consumo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’a été livré depuis %@. iOS retient peut-être l’app : ouvrez-la pour synchroniser, et vérifiez l’actualisation en arrière-plan et le mode Économie d’énergie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से कुछ डिलीवर नहीं हुआ। हो सकता है iOS ऐप को रोक रहा हो: सिंक करने के लिए इसे खोलें, और बैकग्राउंड ऐप रीफ़्रेश और लो पावर मोड जांचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna consegna dal %@. Forse iOS sta frenando l'app: aprila per sincronizzare e controlla Aggiorna app in background e la modalità Risparmio energetico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以降、何も配信されていません。iOSがアプリを止めている可能性があります。アプリを開いて同期し、Appのバックグラウンド更新と低電力モードを確認してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinds %@ is er niets afgeleverd. Misschien houdt iOS de app tegen: open hem om te synchroniseren, en kijk naar Ververs op achtergrond en Energiebesparingsmodus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi entregue desde %@. O iOS pode estar segurando o app: abra-o para sincronizar e confira a Atualização em 2º Plano e o Modo de Pouca Energia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %@ 以来没有送达任何数据。iOS 可能在限制 App：打开 App 即可同步，并请检查后台 App 刷新和低电量模式。"
          }
        }
      }
    },
    "Nothing. The app only asks Apple Health for read access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء. يطلب التطبيق من تطبيق صحتي إذن القراءة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
