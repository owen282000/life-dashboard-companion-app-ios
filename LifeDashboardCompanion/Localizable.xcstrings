    "Custom header \"%@\" is not valid, so nothing was sent. Remove it under Webhook and add it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترويسة المخصصة \"%@\" غير صالحة، لذا لم يُرسل شيء. أزلها من قسم Webhook ثم أضفها مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigener Header \"%@\" ist ungültig, daher wurde nichts gesendet. Entferne ihn unter Webhook und füge ihn neu hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El encabezado personalizado \"%@\" no es válido, así que no se envió nada. Quítalo en Webhook y vuelve a agregarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’en-tête personnalisé « %@ » n’est pas valide, rien n’a donc été envoyé. Supprimez-le sous Webhook et ajoutez-le à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कस्टम हेडर \"%@\" मान्य नहीं है, इसलिए कुछ नहीं भेजा गया। उसे वेबहुक में हटाएँ और फिर से जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'header personalizzato \"%@\" non è valido, quindi non è stato inviato nulla. Rimuovilo in Webhook e aggiungilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムヘッダー「%@」が無効なため、何も送信されませんでした。「Webhook」でこのヘッダーを削除し、追加し直してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigen header \"%@\" is ongeldig, dus er is niets verstuurd. Verwijder hem onder Webhook en voeg hem opnieuw toe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cabeçalho personalizado “%@” não é válido, então nada foi enviado. Remova-o em Webhook e adicione de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义请求头“%@”无效，因此未发送任何内容。请在“Webhook”下将其移除并重新添加。"
          }
        }
      }
    },
    "Custom header \"%@\" under Health > Webhook cannot be sent, so it is left out. Add it again there with a valid name and value." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إرسال الترويسة المخصصة \"%@\" في الصحة > Webhook، لذا تم استبعادها. أضفها مجددًا هناك باسم وقيمة صالحين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigener Header \"%@\" unter Gesundheit > Webhook kann nicht gesendet werden und wird ausgelassen. Füge ihn dort mit einem gültigen Namen und Wert neu hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El encabezado personalizado \"%@\" de Salud > Webhook no se puede enviar, así que se omite. Vuelve a agregarlo allí con un nombre y un valor válidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
