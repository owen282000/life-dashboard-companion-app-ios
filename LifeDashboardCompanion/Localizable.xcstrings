    "This is not a certificate file the iPhone can read. Export it as a .p12 file with its private key." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا ليس ملف شهادة يستطيع iPhone قراءته. صدّره كملف .p12 مع مفتاحه الخاص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine Zertifikatsdatei, die das iPhone lesen kann. Exportiere sie als .p12-Datei mit dem privaten Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este no es un archivo de certificado que el iPhone pueda leer. Expórtalo como archivo .p12 con su clave privada."
