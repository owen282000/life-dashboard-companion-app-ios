        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier ne contient aucun en-tête personnalisé. Ceux de cet iPhone sont conservés, pour les adresses auxquelles ils étaient déjà envoyés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ाइल में कोई कस्टम हेडर नहीं है। इस iPhone पर मौजूद हेडर उन पतों के लिए बने रहते हैं जिन पर वे पहले से भेजे जाते थे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file non contiene header personalizzati. Restano quelli su questo iPhone, per gli indirizzi a cui venivano già inviati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルにはカスタムヘッダーがありません。このiPhoneのカスタムヘッダーは、これまでの送信先アドレスでそのまま使われます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bestand heeft geen eigen headers. Die op deze iPhone blijven behouden, voor de adressen waar ze al heen gingen."
