    },
    "This name has no letters from a to z or digits, so the iPhone stays unnamed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا الاسم على أحرف من a إلى z أو أرقام، لذا يبقى iPhone بدون اسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Name enthält keine Buchstaben von a bis z oder Ziffern, das iPhone bleibt also ohne Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este nombre no tiene letras de la a a la z ni dígitos, así que el iPhone se queda sin nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
