    "Logs and sync progress are not affected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتأثر السجلات وتقدّم المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs und Sync-Fortschritt bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los logs y el progreso de sincronización no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux et la progression de la synchronisation ne sont pas affectés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉग और सिंक की प्रोग्रेस पर असर नहीं पड़ता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I log e l'avanzamento delle sincronizzazioni non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログと同期の進捗には影響しません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs en sync-voortgang blijven zoals ze zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os logs e o progresso da sincronização não são afetados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日志和同步进度不受影响。"
          }
        }
      }
    },
    "Low Power Mode is on, so syncs can wait until it switches off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع الطاقة المنخفضة قيد التشغيل، لذا قد تنتظر المزامنة إلى أن يتوقف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stromsparmodus ist an, daher können Synchronisierungen warten, bis er sich ausschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de bajo consumo está activado, así que las sincronizaciones pueden esperar hasta que se desactive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Économie d’énergie est activé : les synchronisations peuvent attendre qu’il soit désactivé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लो पावर मोड चालू है, इसलिए उसके बंद होने तक सिंक रुक सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Risparmio energetico è attiva, quindi le sincronizzazioni possono aspettare che si disattivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低電力モードがオンなので、オフになるまで同期が待機することがあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energiebesparingsmodus staat aan, dus synchronisaties kunnen wachten tot die uitgaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo de Pouca Energia está ativado, então as sincronizações podem esperar até ele ser desativado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低电量模式已开启，因此同步可能要等到它关闭后才进行。"
          }
        }
      }
    },
    "Lowest %lld, highest %lld, latest %lld" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأدنى %1$lld، الأعلى %2$lld، الأحدث %3$lld"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrigster %1$lld, höchster %2$lld, letzter %3$lld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lowest %1$lld, highest %2$lld, latest %3$lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mínimo %1$lld, máximo %2$lld, último %3$lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimum %1$lld, maximum %2$lld, dernier %3$lld"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे कम %1$lld, सबसे ज़्यादा %2$lld, नई %3$lld"
          }
        },
