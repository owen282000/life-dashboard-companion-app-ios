            "value" : "¿Adónde deben ir tus datos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où envoyer vos données ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका डेटा कहां जाए?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove devono andare i tuoi dati?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データの送信先はどこですか？"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar moet je data naartoe?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para onde seus dados devem ir?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的数据要发送到哪里？"
          }
        }
      }
    },
    "Without TLS your data and broker password cross the internet unencrypted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون TLS تعبر بياناتك وكلمة مرور الوسيط الإنترنت بدون تشفير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne TLS gehen deine Daten und das Broker-Passwort unverschlüsselt durchs Internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin TLS, tus datos y la contraseña del broker viajan por internet sin cifrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans TLS, vos données et le mot de passe du broker traversent Internet sans chiffrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLS के बिना आपका डेटा और ब्रोकर का पासवर्ड बिना एन्क्रिप्शन के इंटरनेट से गुज़रते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza TLS i tuoi dati e la password del broker attraversano internet senza crittografia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TLSを使わないと、データとブローカーのパスワードが暗号化されずにインターネットを通ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder TLS gaan je data en het brokerwachtwoord onversleuteld over het internet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem TLS, seus dados e a senha do broker passam pela internet sem criptografia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不使用 TLS，你的数据和代理服务器密码将以未加密形式通过互联网传输。"
          }
        }
      }
    },
