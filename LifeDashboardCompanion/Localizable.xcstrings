    "Publishes as %@. After a rename, the next sync removes the old device's sensors from the broker." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veröffentlicht als %@. Nach einer Umbenennung entfernt die nächste Synchronisierung die Sensoren des alten Geräts vom Broker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publiceert als %@. Na het wijzigen van de naam verwijdert de volgende synchronisatie de sensors van het oude apparaat van de broker."
          }
        }
      }
    },
    "Publishes today's steps, distance and calories and the latest value of every other synced data type to your MQTT broker with Home Assistant Discovery: sensors appear automatically, no server-side setup needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veröffentlicht die heutigen Schritte, die Distanz und die Kalorien und den letzten Wert jedes anderen synchronisierten Datentyps über Home Assistant Discovery auf deinem MQTT-Broker: Sensoren erscheinen automatisch, ohne Einrichtung auf dem Server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publiceert de stappen, afstand en calorieën van vandaag en de laatste waarde van elk ander gesynchroniseerd datatype naar je MQTT-broker met Home Assistant Discovery: sensors verschijnen automatisch, zonder installatie aan de serverkant."
          }
        }
      }
    },
