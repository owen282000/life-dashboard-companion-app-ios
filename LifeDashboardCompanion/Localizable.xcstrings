    "Delivered, but the Life Dashboard integration did not answer. Check that the entry for this phone still exists." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التسليم، لكن تكامل Life Dashboard لم يستجب. تحقق من أن الإدخال الخاص بهذا الهاتف لا يزال موجودًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugestellt, aber die Life-Dashboard-Integration hat nicht geantwortet. Prüfe, ob der Eintrag für dieses Telefon noch existiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entregado, pero la integración Life Dashboard no respondió. Comprueba que la entrada de este teléfono siga existiendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livré, mais l’intégration Life Dashboard n’a pas répondu. Vérifiez que l’entrée de ce téléphone existe toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिलीवर हुआ, लेकिन Life Dashboard इंटीग्रेशन ने जवाब नहीं दिया। जांचें कि इस फ़ोन की एंट्री अब भी मौजूद है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consegnato, ma l'integrazione Life Dashboard non ha risposto. Controlla che la voce di questo telefono esista ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配信しましたが、Life Dashboard統合から応答がありませんでした。このスマートフォンのエントリがまだあるか確認してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afgeleverd, maar de Life Dashboard-integratie gaf geen antwoord. Controleer of de vermelding voor deze telefoon nog bestaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entregue, mas a integração Life Dashboard não respondeu. Confira se a entrada deste celular ainda existe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已送达，但 Life Dashboard 集成没有响应。请检查这部手机的条目是否仍然存在。"
          }
        }
      }
    },
