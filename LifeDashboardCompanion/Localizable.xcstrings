            "value" : "%@ तक शांत समय। अभी सिंक करें अब भी काम करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ore di silenzio fino alle %@. Sincronizza ora funziona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@まで休止時間帯です。「今すぐ同期」は使えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stille uren tot %@. Nu synchroniseren werkt nog steeds."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horário de silêncio até %@. Sincronizar agora continua funcionando."
          }
        },
