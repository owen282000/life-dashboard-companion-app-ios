    },
    "These settings never sync. Add a time, a day, or shorten the quiet hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesen Einstellungen wird nie synchronisiert. Füge eine Zeit oder einen Tag hinzu oder verkürze die Ruhezeiten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze instellingen wordt er nooit gesynchroniseerd. Voeg een tijd of dag toe, of verkort de stille uren."
          }
        }
      }
    },
    "This address is on the internet without encryption. Anyone along the way can read your health data. Use an https address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
