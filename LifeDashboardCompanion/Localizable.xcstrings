    "These settings never sync. Add a time, a day, or shorten the quiet hours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تتم المزامنة أبدًا بهذه الإعدادات. أضف وقتًا أو يومًا، أو قصّر ساعات الهدوء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesen Einstellungen wird nie synchronisiert. Füge eine Zeit oder einen Tag hinzu oder verkürze die Ruhezeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con esta configuración nunca se sincroniza. Agrega una hora o un día, o acorta las horas de silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
