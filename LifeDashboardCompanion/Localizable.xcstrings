    "Move your settings to another phone. Logs and sync progress stay where they are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل إعداداتك إلى هاتف آخر. تبقى السجلات وتقدّم المزامنة في مكانها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm deine Einstellungen auf ein anderes Telefon mit. Logs und Sync-Fortschritt bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa tu configuración a otro teléfono. Los logs y el progreso de sincronización se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transférez vos réglages vers un autre téléphone. Les journaux et la progression de la synchronisation restent où ils sont."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी सेटिंग्ज़ दूसरे फ़ोन पर ले जाएँ। लॉग और सिंक की प्रोग्रेस जहां हैं वहीं रहती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta le tue impostazioni su un altro telefono. I log e l'avanzamento delle sincronizzazioni restano dove sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定をほかのスマートフォンに移せます。ログと同期の進捗はそのまま残ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je instellingen over naar een andere telefoon. Logs en sync-voortgang blijven waar ze zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe suas configurações para outro celular. Os logs e o progresso da sincronização ficam onde estão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的设置迁移到另一部手机。日志和同步进度会保留在原处。"
          }
        }
      }
    },
