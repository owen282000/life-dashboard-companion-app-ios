    "Sent in 3-day chunks, oldest first. Records are never counted twice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرسل على دفعات كل منها 3 أيام، بدءًا بالأقدم. لا تُحتسب الإدخالات مرتين أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 3-Tage-Blöcken gesendet, älteste zuerst. Datensätze werden nie doppelt gezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía en bloques de 3 días, empezando por los más antiguos. Los registros nunca se cuentan dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé par blocs de 3 jours, en commençant par les plus anciens. Les enregistrements ne sont jamais comptés deux fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3-3 दिन के हिस्सों में भेजा जाता है, सबसे पुराने से शुरू करके। रिकॉर्ड कभी दो बार नहीं गिने जाते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato in blocchi di 3 giorni, dai più vecchi. I record non vengono mai contati due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古い順に3日ずつのブロックで送信します。レコードが二重に数えられることはありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuurd in blokken van 3 dagen, oudste eerst. Records worden nooit dubbel geteld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado em blocos de 3 dias, do mais antigo para o mais recente. Os registros nunca são contados duas vezes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 3 天为一批，从最早的数据开始发送。记录不会被重复计算。"
          }
        }
      }
    },
    "Sent to this address only. Swipe a header to remove it." : {
      "localizations" : {
