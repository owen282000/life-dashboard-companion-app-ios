      }
    },
    "Allow Apple Health access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf Apple Health erlauben"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot Apple Gezondheid geven"
          }
        }
      }
    },
    "Already paired. Nothing changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits gekoppelt. Es ändert sich nichts."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al gekoppeld. Er verandert niets."
          }
        }
      }
    },
    "Apple Health" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Gezondheid"
          }
        }
      }
    },
    "Apple Health data, only for the types you switch on and only after you allow them in the Health access sheet. With Backfill, also older records for the range you pick. When you delete a record in Apple Health, the next sync reports its id so your server can remove it too. The camera is used only by the pairing scanner, while that screen is open: frames are decoded on the phone and are never stored or sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten aus Apple Health, nur für die Typen, die du einschaltest, und erst nachdem du sie im Fenster für den Health-Zugriff erlaubst. Mit Nachtragen auch ältere Datensätze für den Zeitraum, den du wählst. Wenn du einen Datensatz in Apple Health löschst, meldet die nächste Synchronisierung seine ID, damit dein Server ihn auch entfernen kann. Die Kamera nutzt nur der Kopplungsscanner, solange dieser Bildschirm offen ist: Bilder werden auf dem Telefon ausgewertet und nie gespeichert oder gesendet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data uit Apple Gezondheid, alleen voor de types die je aanzet en pas nadat je ze toestaat in het venster voor toegang tot Gezondheid. Met Aanvullen ook oudere records voor de periode die je kiest. Als je een record in Apple Gezondheid verwijdert, meldt de volgende synchronisatie het id ervan, zodat je server het ook kan verwijderen. De camera wordt alleen gebruikt door de koppelscanner, zolang dat scherm open is: beelden worden op de telefoon gedecodeerd en nooit opgeslagen of verstuurd."
          }
        }
      }
    },
    "Apple Health is not available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health ist nicht verfügbar"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Gezondheid is niet beschikbaar"
          }
        }
      }
    },
    "At least 8 characters" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens 8 Zeichen"
