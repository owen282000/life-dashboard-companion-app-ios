    "iOS asks once for each type, and an app never gets to see what you refused." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل iOS مرة واحدة عن كل نوع، ولا يرى التطبيق أبدًا ما رفضته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS fragt für jeden Typ einmal, und eine App erfährt nie, was du abgelehnt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pregunta una vez por cada tipo, y una app nunca puede ver lo que rechazaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS demande une seule fois pour chaque type, et une app ne voit jamais ce que vous avez refusé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS हर टाइप के लिए एक बार पूछता है, और ऐप कभी नहीं देख पाता कि आपने क्या मना किया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS chiede una volta per ogni tipo, e un'app non può mai vedere cosa hai rifiutato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSはタイプごとに1回確認します。拒否した内容をアプリが見ることはありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vraagt het één keer per type, en een app krijgt nooit te zien wat je hebt geweigerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pergunta uma vez para cada tipo, e um app nunca vê o que você recusou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 会针对每种类型询问一次，App 永远看不到你拒绝的内容。"
          }
        }
      }
    },
    "iOS asks once per type" : {
      "localizations" : {
