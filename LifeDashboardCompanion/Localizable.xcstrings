    "A header value can only hold plain ASCII characters, without line breaks or letters such as é" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن أن تحتوي قيمة الترويسة إلا على أحرف ASCII عادية، بدون فواصل أسطر أو أحرف مثل é"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Header-Wert darf nur einfache ASCII-Zeichen enthalten, keine Zeilenumbrüche oder Buchstaben wie é"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valor de encabezado solo puede tener caracteres ASCII simples, sin saltos de línea ni letras como é"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une valeur d’en-tête ne peut contenir que des caractères ASCII simples, sans retour à la ligne ni lettres comme é"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हेडर की वैल्यू में सिर्फ़ सामान्य ASCII वर्ण हो सकते हैं, लाइन ब्रेक या é जैसे अक्षर नहीं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore di un header può contenere solo caratteri ASCII semplici, senza a capo né lettere come é"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッダーの値に使えるのはASCII文字だけです。改行やéのような文字は使えません"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een headerwaarde mag alleen gewone ASCII-tekens bevatten, zonder regeleinden of letters zoals é"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor de um cabeçalho só pode ter caracteres ASCII simples, sem quebras de linha nem letras como é"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求头值只能包含普通 ASCII 字符，不能包含换行符或 é 等字母"
          }
        }
      }
    },
    "A host name cannot contain spaces" : {
      "localizations" : {
