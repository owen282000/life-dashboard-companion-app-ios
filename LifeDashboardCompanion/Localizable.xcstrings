            "state" : "translated",
            "value" : "इस नाम में a से z तक का कोई अक्षर या अंक नहीं है, इसलिए iPhone बिना नाम के रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
