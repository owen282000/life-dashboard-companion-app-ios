    "This device has no camera. Paste the address and the secret by hand instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا الجهاز على كاميرا. الصق العنوان والسر يدويًا بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
