          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前にはaからzの英字も数字もないため、iPhoneの名前は設定されません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze naam bevat geen letters van a tot z of cijfers, dus de iPhone blijft naamloos."
          }
        },
        "pt-BR" : {
