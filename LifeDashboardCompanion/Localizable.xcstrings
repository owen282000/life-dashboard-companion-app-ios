        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Santé n’a répondu pour aucun type de données. La prochaine synchronisation réessaiera"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple स्वास्थ्य ने किसी भी डेटा टाइप के लिए जवाब नहीं दिया। अगला सिंक फिर से कोशिश करेगा"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salute non ha risposto per nessun tipo di dati; la prossima sincronizzazione riprova"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのデータタイプについてもヘルスケアから応答がありませんでした。次回の同期で再試行します"
          }
        },
        "nl" : {
          "stringUnit" : {
