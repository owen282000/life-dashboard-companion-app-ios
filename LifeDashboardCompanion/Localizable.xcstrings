    "Secrets stored in the Keychain" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimnisse im Schlüsselbund gespeichert"
          }
        },
        "nl" : {
          "stringUnit" : {
