    "Secure connection to the broker failed. Check the TLS setting, the port and the broker's certificate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل الاتصال الآمن بالوسيط. تحقق من إعداد TLS والمنفذ وشهادة الوسيط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere Verbindung zum Broker fehlgeschlagen. Prüfe die TLS-Einstellung, den Port und das Zertifikat des Brokers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falló la conexión segura con el broker. Revisa la opción de TLS, el puerto y el certificado del broker."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la connexion sécurisée au broker. Vérifiez le réglage TLS, le port et le certificat du broker."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रोकर से सुरक्षित कनेक्शन नहीं बन सका। TLS सेटिंग, पोर्ट और ब्रोकर का सर्टिफ़िकेट जांचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione sicura al broker non riuscita. Controlla l'impostazione TLS, la porta e il certificato del broker."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブローカーとの安全な接続に失敗しました。TLSの設定、ポート、ブローカーの証明書を確認してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beveiligde verbinding met de broker mislukt. Controleer de TLS-instelling, de poort en het certificaat van de broker."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão segura com o broker falhou. Confira a configuração de TLS, a porta e o certificado do broker."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与代理服务器的安全连接失败。请检查 TLS 设置、端口和代理服务器的证书。"
          }
        }
      }
    },
