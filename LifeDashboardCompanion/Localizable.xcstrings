    "Deletes every log entry. The sync history above is counted from these entries, so it starts over." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل إدخالات السجل. سجل المزامنة أعلاه يُحسب من هذه الإدخالات، لذا سيبدأ من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle Logeinträge. Der Sync-Verlauf oben wird aus diesen Logeinträgen gezählt, er beginnt also von vorn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todas las entradas del log. El historial de sincronización de arriba se cuenta a partir de estas entradas, así que empieza de cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime toutes les entrées du journal. L’historique des synchronisations ci-dessus est calculé à partir de ces entrées : il repart donc de zéro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर लॉग एंट्री मिटा देता है। ऊपर का सिंक इतिहास इन्हीं एंट्री से गिना जाता है, इसलिए वह फिर से शुरू होगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tutte le voci del log. La cronologia sync qui sopra è calcolata da queste voci, quindi ricomincia da zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのログを削除します。上の同期履歴はこのログから集計しているため、最初から数え直しになります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alle logregels. De syncgeschiedenis hierboven wordt uit deze regels geteld, dus die begint opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as entradas do log. O histórico de sincronização acima é contado a partir dessas entradas, então ele recomeça do zero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除所有日志条目。上方的同步历史记录是根据这些条目统计的，因此会重新开始计算。"
          }
        }
      }
    },
