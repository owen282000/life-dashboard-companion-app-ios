    "Camera access is needed to scan a code. You can also paste the address and the secret by hand." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم الوصول إلى الكاميرا لمسح الرمز. يمكنك أيضًا لصق العنوان والسر يدويًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für das Scannen wird Zugriff auf die Kamera benötigt. Du kannst Adresse und Geheimnis auch von Hand eintragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a la cámara para escanear un código. También puedes pegar la dirección y el secreto a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à l’appareil photo est nécessaire pour scanner un code. Vous pouvez aussi coller l’adresse et le secret à la main."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोड स्कैन करने के लिए कैमरे का ऐक्सेस चाहिए। आप पता और सीक्रेट हाथ से भी पेस्ट कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per scansionare un codice serve l'accesso alla fotocamera. Puoi anche incollare a mano l'indirizzo e il segreto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードをスキャンするにはカメラへのアクセスが必要です。アドレスとシークレットを手動で貼り付けることもできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot de camera is nodig om een code te scannen. Je kunt het adres en het geheim ook met de hand invullen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
