    "Skipped %@: iPhone only sends plain HTTP inside your network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تخطي %@: لا يرسل iPhone اتصال HTTP غير المشفّر إلا داخل شبكتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ übersprungen: Das iPhone sendet unverschlüsseltes HTTP nur innerhalb deines Netzwerks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se omitió %@: el iPhone solo envía HTTP sin cifrar dentro de tu red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignoré : l’iPhone n’envoie du HTTP non chiffré qu’à l’intérieur de votre réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ छोड़ा गया: iPhone बिना एन्क्रिप्शन वाला HTTP सिर्फ़ आपके नेटवर्क के अंदर भेजता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ saltato: l'iPhone invia HTTP non crittografato solo all'interno della tua rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をスキップしました：iPhoneが暗号化されていないHTTPで送信するのは、自分のネットワーク内だけです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ overgeslagen: de iPhone verstuurt onversleutelde HTTP alleen binnen je netwerk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignorado: o iPhone só envia HTTP sem criptografia dentro da sua rede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已跳过 %@：iPhone 只会在你的网络内发送普通 HTTP。"
          }
        }
      }
    },
