          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वास्थ्य > वेबहुक में कस्टम हेडर \"%@\" भेजा नहीं जा सकता, इसलिए उसे छोड़ दिया गया है। उसे वहां मान्य नाम और वैल्यू के साथ फिर से जोड़ें।"
