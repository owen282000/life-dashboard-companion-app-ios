    "Keep the app open. The screen stays on until the backfill is done." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ التطبيق مفتوحًا. تبقى الشاشة قيد التشغيل إلى أن ينتهي الاستكمال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die App geöffnet. Der Bildschirm bleibt an, bis das Nachtragen fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la app abierta. La pantalla se queda encendida hasta que termine la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez l’app ouverte. L’écran reste allumé jusqu’à la fin du rattrapage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप खुला रखें। बैकफ़िल पूरा होने तक स्क्रीन चालू रहेगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni aperta l'app. Lo schermo resta acceso finché il recupero non è finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを開いたままにしてください。過去データ送信が終わるまで画面はオンのままです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de app open. Het scherm blijft aan tot het aanvullen klaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o app aberto. A tela fica ligada até o envio do histórico terminar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持 App 打开。屏幕将保持常亮，直到补全完成。"
          }
        }
      }
    },
    "Keep your iPhone unlocked. This can take a while and use mobile data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ iPhone غير مقفل. قد يستغرق ذلك بعض الوقت ويستهلك بيانات الجوّال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dein iPhone entsperrt. Das kann eine Weile dauern und mobile Daten verbrauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el iPhone desbloqueado. Puede tardar un rato y usar datos móviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez votre iPhone déverrouillé. Cela peut prendre un moment et consommer des données mobiles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना iPhone अनलॉक रखें। इसमें समय लग सकता है और मोबाइल डेटा खर्च हो सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni l'iPhone sbloccato. Può richiedere un po' di tempo e usare dati cellulare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneはロックを解除したままにしてください。時間がかかり、モバイルデータ通信を使うことがあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je iPhone ontgrendeld. Dit kan even duren en mobiele data verbruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o iPhone desbloqueado. Isso pode demorar e usar dados móveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持 iPhone 解锁。此过程可能需要一段时间，并可能消耗蜂窝数据。"
          }
        }
      }
    },
