    "HTTP %lld: Google asked for a sign-in, so nothing reached the script. Deploy the Apps Script web app with \"Who has access\" set to Anyone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: طلبت Google تسجيل الدخول، لذا لم يصل شيء إلى النص البرمجي. انشر تطبيق الويب في Apps Script مع ضبط \"مَن يمكنه الوصول\" على \"أي شخص\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: Google hat eine Anmeldung verlangt, das Skript hat also nichts erhalten. Stell die Apps-Script-Web-App unter \"Wer hat Zugriff\" auf \"Jeder\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: Google pidió iniciar sesión, así que no llegó nada al script. Implementa la app web de Apps Script con \"Quién tiene acceso\" configurado en \"Cualquier usuario\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld : Google a demandé une connexion, rien n’est donc parvenu au script. Déployez l’application Web Apps Script avec \"Qui a accès\" défini sur \"Tout le monde\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: Google ने साइन इन करने को कहा, इसलिए स्क्रिप्ट तक कुछ नहीं पहुंचा। Apps Script वेब ऐप को \"किसके पास ऐक्सेस है\" को \"कोई भी\" पर सेट करके डिप्लॉय करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: Google ha chiesto di accedere, quindi niente è arrivato allo script. Esegui il deployment dell'app web di Apps Script con \"Chi ha accesso\" impostato su \"Chiunque\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld：Googleがログインを求めたため、スクリプトには何も届きませんでした。Apps Scriptのウェブアプリを、\"アクセスできるユーザー\"を\"全員\"にしてデプロイしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: Google vroeg om in te loggen, het script heeft dus niets ontvangen. Implementeer de Apps Script-web-app met \"Wie heeft toegang\" op \"Iedereen\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: o Google pediu um login, então nada chegou ao script. Implante o app da Web do Apps Script com \"Quem pode acessar\" definido como \"Qualquer pessoa\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld：Google 要求登录，因此没有任何内容到达脚本。请在部署 Apps Script Web 应用时将\"谁可以访问\"设为\"任何人\"。"
          }
        }
      }
    },
    "HTTP %lld: more than %lld redirects, the last to %@. Enter the final address as the webhook URL." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %1$lld: أكثر من %2$lld من عمليات إعادة التوجيه، آخرها إلى %3$@. أدخل العنوان النهائي كعنوان webhook."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: mehr als %lld Weiterleitungen, die letzte zu %@. Trag die endgültige Adresse als Webhook-URL ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HTTP %1$lld: more than %2$lld redirects, the last to %3$@. Enter the final address as the webhook URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %1$lld: más de %2$lld redirecciones, la última a %3$@. Ingresa la dirección final como URL del webhook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %1$lld : plus de %2$lld redirections, la dernière vers %3$@. Saisissez l’adresse finale comme URL de webhook."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %1$lld: %2$lld से ज़्यादा रीडायरेक्ट, आखिरी %3$@ पर। आखिरी पते को वेबहुक URL के रूप में डालें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %1$lld: più di %2$lld reindirizzamenti, l'ultimo verso %3$@. Inserisci l'indirizzo finale come URL webhook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %1$lld：リダイレクトが%2$lld回を超えました。最後のリダイレクト先は%3$@です。最終的なアドレスをWebhook URLとして入力してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: meer dan %lld doorverwijzingen, de laatste naar %@. Vul het uiteindelijke adres in als webhook-URL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %1$lld: mais de %2$lld redirecionamentos, o último para %3$@. Digite o endereço final como URL do webhook."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %1$lld：重定向超过 %2$lld 次，最后一次指向 %3$@。请将最终地址填写为 Webhook 网址。"
          }
        }
      }
    },
    "HTTP %lld: redirect not followed, so nothing was sent there. Only a redirect on the same host is followed; enter the final address as the webhook URL." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: لم تتم متابعة إعادة التوجيه، لذا لم يُرسل شيء إلى هناك. لا تتم إلا متابعة إعادة التوجيه على المضيف نفسه؛ أدخل العنوان النهائي كعنوان webhook."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: Weiterleitung nicht gefolgt, dorthin wurde also nichts gesendet. Nur einer Weiterleitung auf demselben Host wird gefolgt; trag die endgültige Adresse als Webhook-URL ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: no se siguió la redirección, así que no se envió nada allí. Solo se sigue una redirección en el mismo host; ingresa la dirección final como URL del webhook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld : redirection non suivie, rien n’y a donc été envoyé. Seule une redirection sur le même hôte est suivie. Saisissez l’adresse finale comme URL de webhook."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: रीडायरेक्ट को फ़ॉलो नहीं किया गया, इसलिए वहां कुछ नहीं भेजा गया। सिर्फ़ उसी होस्ट पर रीडायरेक्ट फ़ॉलो होता है। आखिरी पते को वेबहुक URL के रूप में डालें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: reindirizzamento non seguito, quindi lì non è stato inviato nulla. Viene seguito solo un reindirizzamento sullo stesso host; inserisci l'indirizzo finale come URL webhook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld：リダイレクトをたどらなかったため、リダイレクト先には何も送信されていません。たどるのは同じホスト内のリダイレクトだけです。最終的なアドレスをWebhook URLとして入力してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: doorverwijzing niet gevolgd, er is daar dus niets heen gestuurd. Alleen een doorverwijzing op dezelfde host wordt gevolgd; vul het uiteindelijke adres in als webhook-URL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld: redirecionamento não seguido, então nada foi enviado para lá. Só um redirecionamento no mesmo host é seguido; digite o endereço final como URL do webhook."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP %lld：未跟随重定向，因此没有向那里发送任何内容。只会跟随同一主机上的重定向；请将最终地址填写为 Webhook 网址。"
          }
        }
