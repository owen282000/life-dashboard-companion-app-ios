    "Not a valid header name: use letters, digits and hyphens, without spaces or colons" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم ترويسة غير صالح: استخدم الأحرف والأرقام والشرطات، بدون مسافات أو نقطتين"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein gültiger Header-Name: verwende Buchstaben, Ziffern und Bindestriche, ohne Leerzeichen oder Doppelpunkte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es un nombre de encabezado válido: usa letras, dígitos y guiones, sin espacios ni dos puntos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom d’en-tête non valide : utilisez des lettres, des chiffres et des traits d’union, sans espaces ni deux-points"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मान्य हेडर नाम नहीं: अक्षर, अंक और हाइफ़न इस्तेमाल करें, स्पेस या कोलन के बिना"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome dell'header non valido: usa lettere, cifre e trattini, senza spazi né due punti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なヘッダー名ではありません。英字、数字、ハイフンを使い、スペースやコロンは入れないでください"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen geldige headernaam: gebruik letters, cijfers en koppeltekens, zonder spaties of dubbele punten"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome de cabeçalho inválido: use letras, números e hifens, sem espaços nem dois-pontos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求头名称无效：只能使用字母、数字和连字符，不能包含空格或冒号"
          }
        }
      }
    },
    "Not a valid header, so nothing is sent. Remove it and add it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترويسة غير صالحة، لذا لن يُرسل شيء. أزلها ثم أضفها مجددًا."
