    "Reads the Health data types you turned on and delivers them to your webhooks and MQTT broker." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ أنواع البيانات الصحية التي فعّلتها ويسلّمها إلى عناوين webhook ووسيط MQTT الخاصة بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die Datentypen aus Health, die du aktiviert hast, und stellt sie an deine Webhooks und deinen MQTT-Broker zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee los tipos de datos de Salud que activaste y los entrega a tus webhooks y a tu broker MQTT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit les types de données de santé que vous avez activés et les livre à vos webhooks et à votre broker MQTT."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके चालू किए गए स्वास्थ्य डेटा टाइप पढ़ता है और उन्हें आपके वेबहुक और MQTT ब्रोकर पर डिलीवर करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge i tipi di dati sulla salute che hai attivato e li consegna ai tuoi webhook e al tuo broker MQTT."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにした健康データのタイプを読み取り、WebhookとMQTTブローカーに配信します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest de datatypes uit Gezondheid die je hebt aangezet en levert ze af bij je webhooks en je MQTT-broker."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê os tipos de dados de saúde que você ativou e os entrega aos seus webhooks e ao seu broker MQTT."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取你开启的健康数据类型，并将其传送到你的 Webhook 和 MQTT 代理服务器。"
          }
        }
      }
